# Copie para .env.local e ajuste.
# Endereço da API Spring (plataforma/api). Precisa estar no ar durante o build,
# porque as páginas dos cursos são geradas a partir dela.
API_URL=http://localhost:8080

# Endereço público do site (Open Graph, links canônicos).
SITE_URL=http://localhost:3000

# Segredo que a API usa para pedir a revalidação do catálogo (POST /api/revalidar)
# quando um curso é editado no painel. Tem de ser igual ao REVALIDAR_SEGREDO da API.
# Valor de TESTE, só para o ambiente local.
REVALIDAR_SEGREDO=dev-revalidar-7Qm2xL9c
